{#
/**
 * @file
 * Theme override to display a single page.
 */
#}

{# 1. TOP BAR #}
<header class="site-top-bar">
  <div class="container">
    <div class="top-bar-left">
      <span>{{ current_date_formatted|default('Tuesday, December 30, 2025') }}</span>
      <span>|</span>
      <span>FUNIBER Campus Tech</span>
    </div>
    <div class="top-bar-right">
      <div class="top-nav-links">
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
        <a href="#advertise">Advertise</a>
        <a href="#subscribe">Subscribe</a>
      </div>
      <div class="top-social-links">
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.597 0 9 1.583 9 4.615V8z"/></svg>
        </a>
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

{# 2. MAIN HEADER (Logo, Search, Subscribe) #}
<div class="site-header">
  <div class="container">
    <a href="{{ front_page }}" class="site-branding" rel="home">
      <div class="brand-title">Local <span>News</span></div>
    </a>

    <div class="site-header-search">
      <form action="/search" method="get" class="search-form" role="search">
        <svg class="search-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input type="search" name="q" class="search-input" placeholder="Search for news..." aria-label="Search news">
      </form>
    </div>

    <button type="button" class="btn-subscribe" onclick="document.getElementById('newsletter-box')?.scrollIntoView({behavior: 'smooth'})">
      Subscribe
    </button>
  </div>
</div>

{# 3. PRIMARY NAVIGATION #}
<nav class="site-nav" aria-label="Main Navigation">
  <div class="container">
    <button class="nav-mobile-toggle" aria-expanded="false" aria-label="Abrir menú">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    {% if page.primary_menu %}
      {{ page.primary_menu }}
    {% else %}
      <ul class="nav-menu">
        <li class="nav-item"><a href="/" class="nav-link is-active">Home</a></li>
        <li class="nav-item"><a href="/breaking" class="nav-link is-breaking">Breaking News</a></li>
        <li class="nav-item"><a href="/crime" class="nav-link">Crime</a></li>
        <li class="nav-item"><a href="/sports" class="nav-link">Sports</a></li>
        <li class="nav-item"><a href="/business" class="nav-link">Business</a></li>
        <li class="nav-item"><a href="/community" class="nav-link">Community</a></li>
        <li class="nav-item"><a href="/offbeat" class="nav-link">Offbeat</a></li>
        <li class="nav-item"><a href="/opinion" class="nav-link">Opinion</a></li>
        <li class="nav-item"><a href="/videos" class="nav-link">Videos</a></li>
        <li class="nav-item"><a href="/noticias-tech" class="nav-link" style="color: #38BDF8; font-weight: 700;">Tech News API</a></li>
      </ul>
    {% endif %}
  </div>
</nav>

{# 4. MAIN BODY CONTAINER #}
<main id="main-content" class="main-wrapper">
  <div class="container">

    {# HERO BANNER (Breaking News) #}
    {% if page.hero %}
      {{ page.hero }}
    {% else %}
      <section class="hero-banner" aria-label="Breaking News Banner">
        <img src="https://images.unsplash.com/photo-1519501025264-65ba15a82390?auto=format&fit=crop&w=1200&q=80" alt="City council building" class="hero-image">
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <div class="hero-badge-wrap">
            <span class="badge badge-breaking">BREAKING NEWS</span>
          </div>
          <h1 class="hero-title">
            <a href="/breaking-city-hub">Breaking: City Council Approves Major Tech & Education Hub Project</a>
          </h1>
          <p class="hero-description">
            In a unanimous late-night vote, the city council authorized the $45 million revitalization and innovation district in collaboration with international universities, creating over 1,200 tech jobs.
          </p>
          <div class="hero-meta">
            <span>By Sarah Jenkins</span>
            <span>•</span>
            <span>15 minutes ago</span>
            <span>•</span>
            <span>4 min read</span>
          </div>
        </div>
      </section>
    {% endif %}

    {# TOP STORIES (4 Columns) #}
    {% if page.top_stories %}
      {{ page.top_stories }}
    {% else %}
      <section class="top-stories-section" aria-label="Top Stories">
        <div class="top-stories-grid">
          <article class="story-card">
            <div class="story-media">
              <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80" alt="Financial district">
              <span class="badge badge-business">Business</span>
            </div>
            <div class="story-body">
              <h3 class="story-title"><a href="#">Downtown Commercial Real Estate Surges in Q4</a></h3>
              <p class="story-snippet">Tech firms lead new office space leases across the urban corridor.</p>
              <div class="story-meta">
                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>2 hours ago</span>
              </div>
            </div>
          </article>

          <article class="story-card">
            <div class="story-media">
              <img src="https://images.unsplash.com/photo-1546519638-68e109498ffc?auto=format&fit=crop&w=600&q=80" alt="Basketball game">
              <span class="badge badge-sports">Sports</span>
            </div>
            <div class="story-body">
              <h3 class="story-title"><a href="#">Local High School Basketball Team Advances to State Finals</a></h3>
              <p class="story-snippet">A buzzer-beater 3-pointer secures victory in the regional tournament.</p>
              <div class="story-meta">
                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>4 hours ago</span>
              </div>
            </div>
          </article>

          <article class="story-card">
            <div class="story-media">
              <img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=600&q=80" alt="Tech conference">
              <span class="badge badge-tech">Tech</span>
            </div>
            <div class="story-body">
              <h3 class="story-title"><a href="/noticias-tech">FUNIBER Launches Global AI & Cloud Computing Scholarship</a></h3>
              <p class="story-snippet">Full tuition support for 500 students in international postgraduate degrees.</p>
              <div class="story-meta">
                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>5 hours ago</span>
              </div>
            </div>
          </article>

          <article class="story-card">
            <div class="story-media">
              <img src="https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=600&q=80" alt="Community gathering">
              <span class="badge badge-community">Community</span>
            </div>
            <div class="story-body">
              <h3 class="story-title"><a href="#">Annual Innovation & Culture Festival Returns to Waterfront</a></h3>
              <p class="story-snippet">Over 50 international exhibitors and makers participate this weekend.</p>
              <div class="story-meta">
                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>6 hours ago</span>
              </div>
            </div>
          </article>
        </div>
      </section>
    {% endif %}

    {# 2-COLUMN FEED LAYOUT (Main Feed + Sidebar) #}
    <div class="feed-layout">
      
      {# LEFT COLUMN: Articles Feed & Tech News API Module #}
      <div class="feed-main">
        <div class="section-header">
          <div class="section-title">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/><path d="M14 17H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
            Latest News & Updates
          </div>
          <a href="/news" class="section-link">View All &rarr;</a>
        </div>

        {% if page.content %}
          {{ page.content }}
        {% else %}
          <div class="feed-articles-list">
            <article class="article-row-card">
              <div class="article-row-thumb">
                <img src="https://images.unsplash.com/photo-1573164713988-8665fc963095?auto=format&fit=crop&w=500&q=80" alt="Tech research">
              </div>
              <div class="article-row-content">
                <div class="article-row-header">
                  <span class="badge badge-tech">Technology</span>
                  <span class="article-row-meta">Today</span>
                </div>
                <h3 class="article-row-title"><a href="#">New Renewable Energy Microgrid Installed at Campus Science Center</a></h3>
                <p class="article-row-excerpt">The solar-battery microgrid will power 40% of the research laboratory's computing cluster sustainably.</p>
                <div class="article-row-meta">
                  <span>By Dr. Carlos Mendoza</span>
                  <span>•</span>
                  <span>3 min read</span>
                </div>
              </div>
            </article>

            <article class="article-row-card">
              <div class="article-row-thumb">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=500&q=80" alt="Global satellite data">
              </div>
              <div class="article-row-content">
                <div class="article-row-header">
                  <span class="badge badge-business">Innovation</span>
                  <span class="article-row-meta">Yesterday</span>
                </div>
                <h3 class="article-row-title"><a href="#">FUNIBER Academic Network Expands Dual-Degree Programs Across 30 Countries</a></h3>
                <p class="article-row-excerpt">International collaboration strengthens online postgraduate curriculum in software engineering, cybersecurity, and data science.</p>
                <div class="article-row-meta">
                  <span>By Editorial Board</span>
                  <span>•</span>
                  <span>5 min read</span>
                </div>
              </div>
            </article>

            <article class="article-row-card">
              <div class="article-row-thumb">
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=500&q=80" alt="Students studying">
              </div>
              <div class="article-row-content">
                <div class="article-row-header">
                  <span class="badge badge-community">Education</span>
                  <span class="article-row-meta">2 days ago</span>
                </div>
                <h3 class="article-row-title"><a href="#">Hackathon 2026: 300 Students Build Open Source Solutions for Smart Cities</a></h3>
                <p class="article-row-excerpt">Winners developed a real-time IoT air quality monitoring system integrated into civic dashboards.</p>
                <div class="article-row-meta">
                  <span>By Laura Ramos</span>
                  <span>•</span>
                  <span>4 min read</span>
                </div>
              </div>
            </article>
          </div>
        {% endif %}
      </div>

      {# RIGHT COLUMN: Sidebar (Trending, Most Read, Ad) #}
      <aside class="feed-sidebar">
        {% if page.sidebar %}
          {{ page.sidebar }}
        {% else %}
          {# Trending Now Widget #}
          <div class="sidebar-widget">
            <h3 class="widget-title">Trending Now</h3>
            <div class="ranked-list">
              <div class="ranked-item">
                <div class="ranked-number">1</div>
                <div class="ranked-content">
                  <h4 class="ranked-title"><a href="#">City Council Approves $45M Hub Expansion</a></h4>
                  <span class="ranked-meta">2.4k views • 15m ago</span>
                </div>
              </div>
              <div class="ranked-item">
                <div class="ranked-number">2</div>
                <div class="ranked-content">
                  <h4 class="ranked-title"><a href="#">State Tournament Finals: Schedule & Tickets</a></h4>
                  <span class="ranked-meta">1.8k views • 2h ago</span>
                </div>
              </div>
              <div class="ranked-item">
                <div class="ranked-number">3</div>
                <div class="ranked-content">
                  <h4 class="ranked-title"><a href="#">New Tech Startups Open Downtown Headquarters</a></h4>
                  <span class="ranked-meta">1.2k views • 4h ago</span>
                </div>
              </div>
              <div class="ranked-item">
                <div class="ranked-number">4</div>
                <div class="ranked-content">
                  <h4 class="ranked-title"><a href="#">Waterfront Cultural Fest Weekend Lineup</a></h4>
                  <span class="ranked-meta">950 views • 6h ago</span>
                </div>
              </div>
            </div>
          </div>

          {# Educational Promo / Ad Banner #}
          <div class="ad-unit">
            <span class="ad-label">Sponsor</span>
            <h3 class="ad-title">FUNIBER Becas 2026</h3>
            <p class="ad-desc">Maestrías y Doctorados 100% Online en Tecnología, Gestión e Innovación.</p>
            <a href="https://www.funiber.org" target="_blank" rel="noopener noreferrer" class="btn-ad">Solicitar Información</a>
          </div>
        {% endif %}
      </aside>

    </div>

    {# 5. ACADEMIC PROGRAMS SECTION (FUNIBER Special Component) #}
    <section class="academic-section" id="programas-academicos" aria-label="Programas Académicos">
      <div class="section-header">
        <div class="section-title">
          <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/></svg>
          Programas Académicos Destacados
        </div>
        <a href="https://www.funiber.org/maestrias" target="_blank" class="section-link">Ver Catálogo Completo &rarr;</a>
      </div>
      <div class="academic-grid">
        <div class="program-card">
          <span class="program-level">Maestría Internacional</span>
          <h3 class="program-title">Maestría en Dirección Estratégica en Software</h3>
          <p class="program-desc">Especialízate en liderazgo técnico, arquitecturas en la nube, microservicios y gestión ágil de proyectos TI.</p>
          <div class="program-info">
            <span>Modalidad: Online</span>
            <span>Duración: 24 meses</span>
          </div>
        </div>

        <div class="program-card">
          <span class="program-level">Maestría Internacional</span>
          <h3 class="program-title">Maestría en Inteligencia Artificial y Big Data</h3>
          <p class="program-desc">Domina modelos predictivos, Machine Learning, Deep Learning y procesamiento masivo de datos empresariales.</p>
          <div class="program-info">
            <span>Modalidad: Online</span>
            <span>Duración: 24 meses</span>
          </div>
        </div>

        <div class="program-card">
          <span class="program-level">Especialización</span>
          <h3 class="program-title">Especialización en Ciberseguridad y Redes</h3>
          <p class="program-desc">Protege infraestructuras críticas, auditorías de seguridad, ethical hacking y normativas ISO 27001.</p>
          <div class="program-info">
            <span>Modalidad: Online</span>
            <span>Duración: 12 meses</span>
          </div>
        </div>
      </div>
    </section>

    {# 6. CATEGORY SPOTLIGHT (Crime, Sports, Business) #}
    <section class="spotlight-section" aria-label="Category Spotlights">
      <div class="section-header">
        <div class="section-title">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Category Spotlights
        </div>
      </div>
      <div class="spotlight-grid">
        <div class="spotlight-card">
          <div class="spotlight-thumb">
            <img src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=600&q=80" alt="Crime and Law">
          </div>
          <div class="spotlight-body">
            <span class="badge badge-crime" style="align-self: flex-start; margin-bottom: 0.5rem;">Crime & Justice</span>
            <h3 class="spotlight-title"><a href="#">Police Department Deploys Smart Neighborhood Safety Cameras</a></h3>
            <p class="spotlight-text">The initiative aims to decrease incident response times by 35% across central metro areas.</p>
            <div class="spotlight-footer">Updated 3 hours ago</div>
          </div>
        </div>

        <div class="spotlight-card">
          <div class="spotlight-thumb">
            <img src="https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=600&q=80" alt="Sports stadium">
          </div>
          <div class="spotlight-body">
            <span class="badge badge-sports" style="align-self: flex-start; margin-bottom: 0.5rem;">Sports</span>
            <h3 class="spotlight-title"><a href="#">City Arena Renovation Receives Green Building Certification</a></h3>
            <p class="spotlight-text">The multi-purpose complex incorporates 100% recycled rainwater and rooftop solar power.</p>
            <div class="spotlight-footer">Updated 5 hours ago</div>
          </div>
        </div>

        <div class="spotlight-card">
          <div class="spotlight-thumb">
            <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=600&q=80" alt="Business discussion">
          </div>
          <div class="spotlight-body">
            <span class="badge badge-business" style="align-self: flex-start; margin-bottom: 0.5rem;">Business</span>
            <h3 class="spotlight-title"><a href="#">Fintech Incubator Selects 12 Early-Stage Startups for Cohort</a></h3>
            <p class="spotlight-text">Over $2.5M in seed funding granted to founders building cross-border payment rails.</p>
            <div class="spotlight-footer">Updated 8 hours ago</div>
          </div>
        </div>
      </div>
    </section>

    {# 7. NEWSLETTER SIGNUP BOX #}
    <section class="newsletter-box" id="newsletter-box" aria-label="Newsletter">
      <div class="newsletter-content">
        <h3>Stay Informed with Daily Local & Tech News</h3>
        <p>Get the latest breaking headlines, tech updates, and academic opportunities delivered directly to your inbox every morning.</p>
      </div>
      <form class="newsletter-form" action="#" method="post">
        <input type="email" class="newsletter-input" placeholder="Enter your email address" required aria-label="Email for newsletter">
        <button type="submit" class="btn-subscribe">Subscribe Now</button>
      </form>
    </section>

  </div>
</main>

{# 8. INSTITUTIONAL FOOTER (4 Columns) #}
<footer class="site-footer">
  <div class="footer-top">
    <div class="container footer-grid">
      <div class="footer-col">
        <div class="brand-title" style="color: white; margin-bottom: 0.75rem;">Local <span style="color: var(--color-primary);">News</span></div>
        <p style="font-size: 0.85rem; color: var(--color-slate-400); line-height: 1.5; margin-bottom: 1rem;">
          Your trusted source for independent local journalism, breaking updates, academic programs, and technology innovation in partnership with FUNIBER.
        </p>
        <div class="top-social-links">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" style="color: var(--color-slate-400);">Facebook</a>
          <span>•</span>
