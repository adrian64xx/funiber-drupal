<?php

/**
 * @file
 * Functions to support theming in the FUNIBER News Theme.
 */

use Drupal\Component\Utility\Html;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function funiber_theme_preprocess_html(array &$variables): void {
  // Add body classes based on route.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name) {
    $clean_route = Html::cleanCssIdentifier(str_replace('.', '-', $route_name));
    $variables['attributes']['class'][] = 'page-' . $clean_route;
  }

  // Add frontpage class.
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['attributes']['class'][] = 'is-frontpage';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function funiber_theme_preprocess_page(array &$variables): void {
  // Pass formatted current date for top bar.
  $date_formatter = \Drupal::service('date.formatter');
  $variables['current_date_formatted'] = $date_formatter->format(
    \Drupal::time()->getRequestTime(),
    'custom',
    'l, F j, Y'
  );

  // Pass site metadata.
  $config = \Drupal::config('system.site');
  $variables['site_name'] = $config->get('name') ?? 'FUNIBER News Portal';
  $variables['site_slogan'] = $config->get('slogan') ?? 'Portal de Innovación y Tecnología';
}

/**
 * Implements hook_preprocess_HOOK() for block.html.twig.
 */
function funiber_theme_preprocess_block(array &$variables): void {
  // Add custom class to system branding block.
  if ($variables['base_plugin_id'] === 'system_branding_block') {
    $variables['attributes']['class'][] = 'funiber-brand-block';
  }
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function funiber_theme_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  // Calculate read time estimate (200 words/min).
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_text = strip_tags($node->get('body')->value ?? '');
    $word_count = str_word_count($body_text);
    $minutes = max(1, (int) ceil($word_count / 200));
    $variables['read_time'] = $minutes . ' min read';
  } else {
    $variables['read_time'] = '2 min read';
  }

  // Formatted date.
  $variables['formatted_created'] = \Drupal::service('date.formatter')->format(
    $node->getCreatedTime(),
    'custom',
    'M j, Y'
  );
}
