# ==============================================================================
# FUNIBER Drupal 11 - Environment Configuration
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=funiber_news_portal

# Ports
WEB_PORT=8080
DB_PORT=3306

# Database Settings
DB_NAME=drupal11
DB_USER=drupal
DB_PASSWORD=drupal_secret_pass
DB_ROOT_PASSWORD=root_secret_pass
DB_HOST=database
DB_DRIVER=mysql

# Drupal Settings
DRUPAL_SITE_NAME="FUNIBER News Portal"
DRUPAL_ACCOUNT_NAME=admin
DRUPAL_ACCOUNT_PASS=admin1234
DRUPAL_ACCOUNT_MAIL=admin@funiber.org
